# ==============================================================================
# MediVault - Git Ignore Rules
# Excludes development, test, agent, build, and sensitive files from GitHub
# ==============================================================================

# Agent & AI Workflow Metadata
.agent/

# Development, Documentation Registry, Helper Scripts & Test Suites
docs/
scripts/
tests/

# Local Generated Clinical Data & Backups
lab-data/

# Environment Variables & Secret Credentials
.env
.env.local
.env.*.local
*.env
token.json
token_*.json

# Databases & SQLite Storage
*.db
*.sqlite
*.sqlite3
medivault.db
test_medivault.db
*.db-journal
*.db-wal
*.db-shm

# Python Virtual Environments & Bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Application & Audit Logs
*.log
backend/app.log

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local Host Utility Scripts
python.cmd
timeout.cmd

# Operating System & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
