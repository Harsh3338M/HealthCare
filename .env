# MediVault Environment Configuration Template

# Database Configuration (SQLite local database)
DATABASE_URL=sqlite:///./medivault.db

# Authentication / JWT Settings
SECRET_KEY=medivault-insecure-secret-key-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage Paths
UPLOAD_DIR=lab-data/uploads
BACKUP_DIR=lab-data/backups

# ==============================================================================
# SENSITIVE, TEMPORARY & REDUNDANT ARTIFACTS (NOT TO BE UPLOADED TO GITHUB)
# ==============================================================================
# 1. AI Assistant & Agent Execution Logs
# .agent/
# .agent/**
#
# 2. Environment Configurations & Secret Credentials
# .env
# .env.local
# .env.*.local
# *.env
# token.json
# token_*.json
#
# 3. Application Audit & Debug Logs
# *.log
# backend/app.log
#
# 4. Local SQLite Databases & Transaction Journals
# *.db
# *.sqlite
# *.sqlite3
# medivault.db
# test_medivault.db
# *.db-journal
# *.db-wal
# *.db-shm
#
# 5. Generated Diagnostic Report Files & Database Backups
# lab-data/uploads/*
# lab-data/backups/*
# lab-data/
#
# 6. Python Virtual Environments, Bytecode & Packages
# .venv/
# venv/
# env/
# __pycache__/
# *.py[cod]
# *.pyc
# *.pyd
#
# 7. Node Dependencies & Frontend Production Builds
# node_modules/
# frontend/node_modules/
# frontend/dist/
# dist/
# .vite/
# frontend/.vite/
#
# 8. Testing & Coverage Caches
# .pytest_cache/
# .coverage
# htmlcov/
#
# 9. Local Runner Wrappers & Environment Scripts
# python.cmd
# timeout.cmd
#
# 10. Operating System & IDE Cache Files
# .DS_Store
# Thumbs.db
# .vscode/
# .idea/
